#list{flex:1;overflow-y:auto;padding:14px}
#empty{position:absolute;inset:45% 0 auto 0;text-align:center;color:#888;font-size:20px;font-weight:600;pointer-events:none}
.bubble{max-width:86%;margin:0 0 12px;padding:10px 14px;border-radius:16px;font-size:16px;
line-height:1.5;white-space:pre-wrap;word-break:break-word}
.bubble.user{margin-left:auto;background:#f4f4f5}
.bubble.assistant{border:1px solid #f0f0f0}
.bubble.pending::after{content:"\\258D";opacity:.5}
#row{display:flex;gap:8px;padding:8px 10px;border-top:1px solid #eee}
#input{flex:1;min-height:44px;border:1px solid #e5e5e5;border-radius:20px;padding:10px;font-size:16px;font-family:inherit}
#send{flex:0 0 62px;border:0;border-radius:20px;background:#000;color:#fff}
#traces{display:none;max-height:26%;overflow-y:auto;margin:0;padding:6px 10px;border-top:1px solid #eee;
background:#fafafa;font:11px/1.5 ui-monospace,monospace;white-space:pre-wrap}
#traces.on{display:block}
#pane-tests{flex:1;min-height:0;overflow-y:auto;padding:14px;display:none;font-size:13px}
