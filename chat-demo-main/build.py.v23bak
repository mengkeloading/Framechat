#bar{display:flex;gap:6px;align-items:center;padding:6px 10px;border-bottom:1px solid #eee;font-size:12px}
#bar input{flex:1;min-width:0;border:1px solid #ddd;border-radius:8px;padding:4px 6px;font-size:12px}
#bar button{border:1px solid #ddd;background:#fff;border-radius:8px;padding:4px 8px;font-size:12px}
