</style></head><body>
<div id="tabs">
  <button data-tab="chat" class="on">聊天</button>
  <button data-tab="tests">验收</button>
</div>
<div id="pane-chat">
  <div id="bar">
    <label><input type="checkbox" id="live"> 真接口</label>
    <input id="key" type="password" placeholder="API Key（仅内存）">
    <span id="state">idle</span><button id="menu">trace</button>
  </div>
  <div id="listbox"><div id="list"></div><div id="empty">你好，请等会儿再来吧</div></div>
  <div id="row"><textarea id="input" rows="1" placeholder="发消息或按住说话"></textarea>
    <button id="send">发送</button></div>
  <pre id="traces"></pre>
</div>
<div id="pane-tests"><div id="out"></div><div id="sum"></div></div>
"""

TAIL = """
<script>
var __PKGS__ = [];
document.querySelectorAll('#tabs button').forEach(function (b) {
  b.addEventListener('click', function () {
    document.querySelectorAll('#tabs button').forEach(function (x) { x.classList.remove('on'); });
    b.classList.add('on');
    var t = b.getAttribute('data-tab');
    document.getElementById('pane-chat').style.display = (t === 'chat') ? 'flex' : 'none';
    document.getElementById('pane-tests').style.display = (t === 'tests') ? 'block' : 'none';
  });
});
</script></body></html>
"""


def parse_fm(text):
    m = re.match(r"^---\s*\n(.*?)\n---\s*\n?(.*)$", text, re.S)
    if not m:
        return {}, text
    fm, body, key = {}, m.group(2), None
    for line in m.group(1).split("\n"):
        if not line.strip():
            continue
        if re.match(r"^\s+\S", line) and key and isinstance(fm.get(key), dict):
            k, v = line.strip().split(":", 1)
            v = v.strip()
            fm[key][k.strip()] = int(v) if v.isdigit() else v.strip('"\'')
            continue
        if ":" in line:
            key, val = line.split(":", 1)
            key, val = key.strip(), val.strip()
            if val == "":
                fm[key] = {}
            elif val.startswith("[") and val.endswith("]"):
                fm[key] = [x.strip() for x in val[1:-1].split(",") if x.strip()]
            elif val.isdigit():
                fm[key] = int(val)
            else:
                fm[key] = val.strip('"\'')
    return fm, body


def scan():
    pkgs, skipped = [], []
    base = ROOT / "modules"
    if not base.is_dir():
        return pkgs, skipped
    for folder in sorted(base.iterdir()):
        if not folder.is_dir():
            continue
        md = folder / "MODULE.md"
        if not md.exists():
            skipped.append(folder.name)
            continue
        fm, body = parse_fm(md.read_text(encoding="utf-8"))
        pkg = {
            "id": fm.get("id") or folder.name,
            "name": fm.get("name") or folder.name,
            "description": fm.get("description") or "",
            "version": str(fm.get("version") or "0.0.0"),
            "hooks": fm.get("hooks") or [],
            "inject": fm.get("inject") or ("none" if fm.get("entry") else "full"),
            "capabilities": fm.get("capabilities") or {},
            "body": body.strip(),
            "references": {},
            "scripts": {},
        }
        pkg["tools"] = fm.get("tools") or []
        if not isinstance(pkg["tools"], list):
            pkg["tools"] = []
        pkg["tools"] = fm.get("tools") or []
        if not isinstance(pkg["tools"], list):
            pkg["tools"] = []
        if not isinstance(pkg["hooks"], list):
            pkg["hooks"] = []
        if not isinstance(pkg["capabilities"], dict):
            pkg["capabilities"] = {}
        rd = folder / "reference"
        if rd.is_dir():
            for f in sorted(rd.iterdir()):
                if f.is_file():
                    pkg["references"][f.name] = f.read_text(encoding="utf-8")
        sd = folder / "script"
        if sd.is_dir():
            for f in sorted(sd.rglob("*.js")):
                pkg["scripts"][str(f.relative_to(folder)).replace("\\", "/")] = \
                    f.read_text(encoding="utf-8")
        pkg["entry"] = fm.get("entry") or \
            ("script/main.js" if "script/main.js" in pkg["scripts"] else None)
        pkgs.append(pkg)
    return pkgs, skipped


def count_checks(rel):
    p = ROOT / rel
    if not p.exists():
        return None
    t = p.read_text(encoding="utf-8")
    return t.count("check(") - 1   # 减去函数定义那次


def main():
    print("构建开始\n")

    pkgs, skipped = scan()
    missing = [c for c in CORE if not (ROOT / c).exists()]

    print("模块包扫描:")
    if pkgs:
        for p in pkgs:
            print("  + " + p["id"] + "   hooks=" + str(p["hooks"]) +
                  " inject=" + p["inject"] +
                  " refs=" + str(len(p["references"])) +
                  " caps=" + str(list(p["capabilities"].keys())))
    else:
        print("  (无)")
    if skipped:
        print("  跳过（无 MODULE.md）: " + ", ".join(skipped))

    print("\n核心脚本:")
    for c in CORE:
        print(("  + " if c not in missing else "  ! 缺 ") + c)

    n1 = count_checks("js/tests/selftest.js")
    n2 = count_checks("js/tests/l1test.js")
    n3 = count_checks("js/tests/v1_gaps_test.js")
    n4 = count_checks("js/tests/session_test.js")
    n5 = count_checks("js/tests/modules_test.js")
    n6 = count_checks("js/tests/features_test.js")
    n7 = count_checks("js/tests/persist_test.js")
    print("\n断言统计:")
    print("  框架 selftest.js : " + (str(n1) if n1 is not None else "缺失"))
    print("  L1   l1test.js   : " + (str(n2) if n2 is not None else "缺失"))
    print("  缺口 v1_gaps    : " + (str(n3) if n3 is not None else "缺失"))
    print("  会话隔离        : " + str(n4))
    print("  模块库          : " + str(n5))
    print("  基础功能        : " + str(n6))
    print("  日常可用        : " + str(n7))

    if not pkgs:
        print("\n!! 没有扫描到模块包，打包中止。检查 modules/*/MODULE.md")
        return 1
    if missing:
        print("\n!! 缺少核心文件，打包中止：")
        for m in missing:
            print("   " + m)
        print("   先跑 port_skill.py 重新写入这些文件。")
        return 1

    shell_path = ROOT / "ui/shell.html"
    shell = shell_path.read_text(encoding="utf-8") if shell_path.exists() else SHELL
    (ROOT / "dist").mkdir(parents=True, exist_ok=True)
    parts = [shell]
    for rel in CORE:
        code = (ROOT / rel).read_text(encoding="utf-8").replace("</script", "<\\/script")
        parts.append("\n<script>\n/* ===== " + rel + " ===== */\n" + code + "\n</script>\n")
    for pkg in pkgs:
        js = json.dumps(pkg, ensure_ascii=False).replace("</script", "<\\/script")
        parts.append("\n<script>\n/* ===== package " + pkg["id"] + " ===== */\n"
                     "ModuleLoader.registerPackage(" + js + ");\n</script>\n")
    parts.append(TAIL)
    html = "".join(parts)

    written = []
    for t in [ROOT / OUT]:
        try:
            t.write_text(html, encoding="utf-8")
            written.append(t)
        except Exception as e:
            print("! 写入失败 " + str(t) + ": " + e)

    total = (n1 or 0) + (n2 or 0) + (n3 or 0) + (n4 or 0) + (n5 or 0) + (n6 or 0) + (n7 or 0)
    print("\n" + "=" * 46)
    print("模块包      : " + str(len(pkgs)) + " 个")
    print("核心脚本    : " + str(len(CORE)) + " 个")
    print("外部引用    : " + str(html.count("src=")) + "  (必须为 0)")
    print("文件大小    : " + str(len(html)) + " 字符")
    print("预期断言数  : " + str(total))
    print("=" * 46)
    print("")
    for t in written:
        print("已写入 " + str(t))
    print("")
    if total < 38:
        print("注意：预期断言数不是 38。l1test.js 缺失或条数不对，")
        print("      重跑 port_skill.py 补齐后再跑本脚本。")
    else:
        print(">>> 打开 dist/mychat-demo.html，点【验收】，全部通过")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())