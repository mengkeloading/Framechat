#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""build.py — 扫描 modules/ 打包，并打印自查清单"""

import json
import re
import time
from pathlib import Path

ROOT = Path("/storage/emulated/0/demo/chat-demo-main")
OUT = "dist/mychat-demo.html"

CORE = [
    "js/module/modulekit.js",
    "js/module/moduleloader.js",
    "js/bridge/hostbridge.js",
    "js/js/executor.js",
    "js/network/sseparser.js",
    "js/network/providers.js",
    "js/network/apiclient.js",
    "js/data/persist.js",
    "js/ui/md.js",
    "js/network/compactor.js",
    "js/network/requestbuilder.js",
    "js/module/moduledispatcher.js",
    "js/error/errormapper.js",
    "js/data/daos.js",
    "js/vm/chatviewmodel.js",
    "js/ui/chatscreen.js",
    "js/tests/selftest.js",
    "js/tests/l1test.js",
    "js/tests/v1_gaps_test.js",
    "js/tests/session_test.js",
    "js/tests/modules_test.js",
    "js/tests/features_test.js",
    "js/tests/persist_test.js",
    "js/tests/api_check.js",
    "js/ui/export.js",
    "js/ui/tts.js",
    "js/boot.js",
    "js/ui/extra.js",
    "js/ui/panel.js",
    "js/ui/scrollfab.js",
]

SHELL = """<!DOCTYPE html><html lang="zh-CN"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"><title>MyChat demo</title>
<style>
*{box-sizing:border-box}html,body{margin:0;height:100%;color:#1a1a1a;background:#fff;
font-family:-apple-system,"PingFang SC",sans-serif}
body{display:flex;flex-direction:column}
#tabs{display:flex;gap:8px;padding:8px;border-bottom:1px solid #eee}
