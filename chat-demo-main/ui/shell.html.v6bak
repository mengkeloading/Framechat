<!DOCTYPE html>
<html lang="zh-CN"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<title>MyChat</title>
<style>
:root{--bg:#fff;--bg2:#f5f5f5;--line:#e5e5e5;--div:#f0f0f0;
--tx:#0f0f0f;--tx2:#545557;--ph:#8e9094;--brand:#426efe}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;text-size-adjust:100%}
html,body{margin:0;height:100%;background:var(--bg);color:var(--tx);
font-family:-apple-system,"PingFang SC","Noto Sans CJK SC",sans-serif}
body{display:flex;flex-direction:column;overflow:hidden}
#pane-chat{flex:1;min-height:0;display:flex;flex-direction:column}
#pane-tests{flex:1;min-height:0;display:none;flex-direction:column}
/* 顶栏 */
header{flex:0 0 52px;height:52px;display:grid;grid-template-columns:auto 1fr auto;
align-items:center;padding:0 10px;border-bottom:1px solid var(--div)}
header .title{text-align:center;font-size:15px;font-weight:500;
overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
header .ic{width:24px;height:24px;display:flex;align-items:center;justify-content:center}
header .r{display:flex;align-items:center;gap:10px}
header svg{display:block}
/* 消息区 */
#listbox{position:relative;flex:1;min-height:0;display:flex;flex-direction:column}
#list{flex:1;overflow-y:auto;padding:0 16px 20px;-webkit-overflow-scrolling:touch}
#empty{position:absolute;inset:45% 0 auto 0;text-align:center;color:var(--ph);
font-size:20px;font-weight:600;pointer-events:none}
.bubble{font-size:16px;line-height:26px;white-space:pre-wrap;word-break:break-word;
margin-bottom:10px}
.bubble.user{background:var(--bg2);border-radius:16px;padding:10px 14px;
max-width:86%;margin-left:auto}
.bubble.assistant{padding:11px 0 0}
.bubble.pending::after{content:"\258D";opacity:.5}
.bubble p{margin:10px 0}.bubble p:first-child{margin-top:0}
.bubble h1,.bubble h2,.bubble h3{margin:14px 0 8px;font-size:17px;line-height:24px}
.bubble ul{margin:8px 0;padding-left:20px}
.bubble code{background:#f2f2f3;border-radius:5px;padding:1px 4px;font-size:.9em}
.bubble hr{border:0;height:1px;background:var(--line);margin:14px 0}
.acts{display:flex;gap:6px;padding-top:6px}
.acts button{height:26px;padding:0 8px;border:0;border-radius:8px;background:transparent;
color:var(--ph);font-size:12px}
.tagstop,.tagrw,.taglocal{display:inline-block;margin-left:6px;font-size:11px;color:var(--ph)}
.tagrw{color:var(--brand)}
.codeblock{margin:10px 0;border-radius:12px;overflow:hidden;background:#f7f7f8;
border:1px solid #ececec}
.codeblock .banner{height:34px;display:flex;align-items:center;
justify-content:space-between;padding:0 10px;background:#f0f0f1;
font-size:12px;color:var(--ph);font-family:ui-monospace,monospace}
.codeblock .copycode{height:24px;padding:0 8px;border:0;border-radius:6px;
background:transparent;color:var(--ph);font-size:12px}
.codeblock pre{margin:0;padding:14px;overflow-x:auto;
font:12.5px/1.7 ui-monospace,Menlo,monospace;color:#1a1a1a}
/* 提示条 / 错误条 */
#errbar{display:none;margin:0 12px 6px;padding:11px 14px;border-radius:18px;
background:var(--bg2);color:var(--ph);font-size:13px;line-height:19px}
#errbar button{float:right;border:0;border-radius:8px;background:#f8d7d4;
color:#c0392b;font-size:12px;padding:2px 10px;margin-left:8px}
/* 输入区 */
footer{flex:0 0 auto;padding:6px 8px calc(8px + env(safe-area-inset-bottom))}
.card{background:var(--bg2);border:1px solid var(--line);border-radius:24px;padding:0}
#files{display:none;gap:8px;padding:12px 12px 0;flex-wrap:wrap}
.chipfile{display:inline-flex;align-items:center;height:28px;padding:0 10px;
border-radius:14px;background:#fff;border:1px solid var(--line);font-size:12px;color:var(--tx2)}
#input{display:block;width:100%;border:0;background:transparent;resize:none;outline:none;
font:16px/24px inherit;color:var(--tx);padding:12px 12px 0 16px;min-height:42px;
max-height:140px}
#input::placeholder{color:var(--ph)}
.frow{display:flex;align-items:center;justify-content:space-between;padding:12px;
margin-top:4px}
.caps{display:flex;gap:8px}
.cap{height:32px;padding:0 12px;border-radius:16px;background:#fff;
border:1px solid var(--line);font-size:13px;font-weight:500;color:var(--tx);
display:flex;align-items:center;gap:5px}
.cap svg{width:15px;height:15px}
.cap.on{background:#eaf1ff;border-color:#cfe0ff;color:var(--brand)}
.right{display:flex;align-items:center;gap:10px}
.icbtn{width:30px;height:30px;border:0;background:none;padding:0;
display:flex;align-items:center;justify-content:center}
.icbtn svg{width:24px;height:24px}
#voiceBtn{width:30px;height:30px;border-radius:15px;border:1px solid var(--tx);
display:none;align-items:center;justify-content:center;background:#fff}
#voiceBtn svg{width:18px;height:18px}
.send{width:30px;height:30px;border-radius:15px;border:0;background:#000;
display:flex;align-items:center;justify-content:center;padding:0}
.send svg{width:18px;height:18px}
.send:disabled{background:var(--line)}
/* 抽屉 */
#scrim{position:fixed;inset:0;background:rgba(0,0,0,.35);display:none;z-index:20}
#drawer{position:fixed;top:0;left:0;bottom:0;width:280px;background:#fafafa;
transform:translateX(-100%);transition:transform 220ms cubic-bezier(.2,0,0,1);
display:flex;flex-direction:column;padding:12px 10px;z-index:21;overflow-y:auto}
#drawer.on{transform:none}
#scrim.on{display:block}
.dsearch{display:flex;align-items:center;gap:8px;height:38px;border-radius:19px;
background:var(--bg2);padding:0 14px;font-size:14px;color:var(--ph);margin-bottom:10px}
.dsearch svg{width:18px;height:18px}
.dnew{height:40px;border-radius:12px;background:#fff;border:1px solid var(--line);
display:flex;align-items:center;gap:8px;padding:0 12px;font-size:14px;font-weight:500}
.dgrp{font-size:12px;color:#b9babb;padding:14px 4px 6px}
.ditem{height:40px;display:flex;align-items:center;padding:0 6px;border-radius:8px;
font-size:15px;color:var(--tx);overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.ditem.on{background:#ececec;font-weight:500}
.dbottom{margin-top:auto;border-top:1px solid #ececec;padding-top:6px}
.daccount{display:flex;align-items:center;gap:10px;padding:10px 6px}
.ava{width:30px;height:30px;border-radius:15px;background:#e2e2e2}
.mail{font-size:13px;color:var(--ph)}
/* 设置面板 */
#sheetMask{position:fixed;inset:0;background:rgba(0,0,0,.35);display:none;z-index:90}
#sheet{position:fixed;left:0;right:0;bottom:0;z-index:91;background:#fff;
border-radius:20px 20px 0 0;padding:16px 16px calc(16px + env(safe-area-inset-bottom));
display:none;max-height:84%;overflow-y:auto}
#sheet.on,#sheetMask.on{display:block}
#sheet h3{margin:0 0 14px;font-size:15px}
.f{margin-bottom:12px}
.f label{display:block;font-size:12px;color:var(--ph);margin-bottom:4px}
.f input,.f select,.f textarea{width:100%;border:1px solid var(--line);border-radius:10px;
padding:8px 10px;font-size:14px;font-family:inherit;outline:none;background:#fff}
.f textarea{min-height:64px}
.f .hint{font-size:11px;color:#b9babb;margin-top:4px}
.f.chk{display:flex;align-items:center;gap:8px;font-size:14px}
.f.chk input{width:auto}
.miniRow{display:flex;gap:8px}
.mini{flex:1;height:36px;border-radius:10px;border:1px solid #e5e5e5;background:#fff;font-size:13px;color:#0f0f0f}
.mini.danger{color:#c0392b;border-color:#f0c9c6}
.sheetBtns{display:flex;gap:8px;margin-top:12px}
.sheetBtns button{flex:1;height:40px;border-radius:12px;border:1px solid var(--line);
background:#fff;font-size:14px}
.sheetBtns button.primary{background:#1a1a1a;color:#fff;border-color:#1a1a1a}
/* 验收 */
.thead{flex:0 0 52px;height:52px;display:flex;align-items:center;gap:10px;
padding:0 12px;border-bottom:1px solid var(--div);font-size:15px;font-weight:500}
.thead button{border:1px solid var(--line);background:#fff;border-radius:10px;
padding:5px 10px;font-size:12px}
#pane-tests .body{flex:1;overflow-y:auto;padding:14px;font-size:13px}
#traces{display:none;max-height:30%;overflow:auto;margin:0;padding:6px 10px;
border-top:1px solid var(--div);background:#fafafa;
font:11px/1.5 ui-monospace,monospace;white-space:pre-wrap;color:#444}
.case{margin:14px 0 4px;font-weight:600}
.row{display:flex;gap:8px;padding:2px 0}
.tag{flex:0 0 44px;font-weight:600}
.ok{color:#12805c}.fail{color:#c0392b}
.detail{color:#c0392b;font-size:12px;padding-left:52px;word-break:break-all}
#sum{margin-top:16px;padding:12px;border-radius:10px;font-weight:600}
#sum.pass{background:#eaf7f1;color:#12805c}
#sum.fail{background:#fdeceb;color:#c0392b}

/* 屏蔽浏览器手势 */
html,body{overscroll-behavior:none;touch-action:manipulation}
body{-webkit-touch-callout:none;-webkit-user-select:none;user-select:none}
#list{overscroll-behavior-y:contain;touch-action:pan-y}
#drawer,#sheet,#sheet .body{overscroll-behavior:contain}
textarea,input,.bubble,.codeblock pre,.ditem{
  -webkit-user-select:text;user-select:text;
  -webkit-touch-callout:default}

#empty{display:flex;flex-direction:column;align-items:center;gap:14px}
.whale{width:120px;height:80px;opacity:.95}
.emptyText{color:#8e9094;font-size:20px;font-weight:600}
#notice{display:none;margin:0 12px 6px;padding:11px 14px;border-radius:18px;background:#f5f5f5;color:#8e9094;font-size:13px;line-height:19px}
#notice i{font-style:normal;margin-right:6px;color:#b9babb}
#soundBtn.muted{color:#b9babb}

.mtable{width:100%;border-collapse:collapse;margin:12px 0;font-size:14px}
.mtable th,.mtable td{border:1px solid #e5e5e5;padding:8px 10px;text-align:left}
.mtable th{background:#fafafa;font-weight:600}
#jumpBtn{position:absolute;right:16px;bottom:16px;width:36px;height:36px;border-radius:18px;background:#fff;border:1px solid #e5e5e5;display:none;align-items:center;justify-content:center;z-index:6;box-shadow:0 2px 8px rgba(0,0,0,.08)}
#jumpBtn svg{width:18px;height:18px}

.mods{display:flex;flex-direction:column;gap:6px}
.mod{display:flex;align-items:center;gap:8px;border:1px solid #e5e5e5;border-radius:10px;padding:8px 10px;background:#fff}
.mod.on{border-color:#cfe0ff;background:#f4f8ff}
.modMain{flex:1;min-width:0}
.modName{font-size:14px;color:#0f0f0f}
.modDesc{font-size:11px;color:#8e9094;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.modSw{flex:0 0 auto;font-size:12px;color:#8e9094;border:1px solid #e5e5e5;border-radius:10px;padding:2px 8px}
.mod.on .modSw{color:#426efe;border-color:#cfe0ff;background:#eaf1ff}
#toast{position:fixed;left:50%;bottom:80px;transform:translateX(-50%);background:rgba(20,20,20,.9);color:#fff;font-size:13px;padding:8px 14px;border-radius:10px;opacity:0;pointer-events:none;transition:opacity .2s;z-index:999}
#toast.on{opacity:1}

#modPanel{max-height:0;overflow:hidden;transition:max-height .22s ease;background:#fff;border-top:1px solid #f0f0f0}
#modPanel.on{max-height:46vh;overflow-y:auto;-webkit-overflow-scrolling:touch}
.mpHead{font-size:12px;color:#8e9094;padding:10px 14px 4px}
.mpItem{display:flex;align-items:center;gap:10px;padding:10px 14px;border-bottom:1px solid #f5f5f5}
.mpMain{flex:1;min-width:0}
.mpName{font-size:14px;color:#0f0f0f}
.mpDesc{font-size:11px;color:#8e9094;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mpSw{font-size:11px;color:#8e9094;border:1px solid #e5e5e5;border-radius:9px;padding:2px 8px}
.mpItem.on .mpSw{color:#426efe;border-color:#cfe0ff;background:#eaf1ff}
#sheet{overscroll-behavior:contain;-webkit-overflow-scrolling:touch}
#list,#drawer,#modPanel{touch-action:pan-y}
.setItem{display:flex;align-items:center;justify-content:space-between;padding:14px 4px;font-size:15px;border-bottom:1px solid #f5f5f5}
.setItem span{color:#b9babb}
.setBack{display:flex;align-items:center;gap:8px;padding:4px 0 12px;color:#8e9094;font-size:13px}
.setPage{display:none}
.setPage.on{display:block}

.caps{gap:8px}
.cap{width:32px;height:32px;padding:0;justify-content:center;white-space:nowrap;font-size:0;gap:0}
.cap svg{width:17px;height:17px}
#ctxPop{position:absolute;left:8px;right:8px;bottom:100%;margin-bottom:6px;background:#fff;border:1px solid #e5e5e5;border-radius:14px;padding:12px 14px;font-size:13px;color:#545557;line-height:1.7;display:none;z-index:8;box-shadow:0 6px 20px rgba(0,0,0,.08)}
#ctxPop.on{display:block}
#ctxPop b{color:#0f0f0f;font-weight:500}
footer{position:relative}

#modPanel{display:none;background:#fff;border-top:1px solid #f0f0f0;max-height:52vh;overflow-y:auto;-webkit-overflow-scrolling:touch}
.pnl{padding:14px}
.pnl+ .pnl{border-top:1px solid #f5f5f5}
.pnlH{font-size:12px;color:#8e9094;margin-bottom:8px;display:flex;justify-content:space-between}
.pnlInput{width:100%;border:1px solid #e5e5e5;border-radius:10px;padding:9px 12px;font-size:14px;font-family:inherit;outline:none;background:#fff}
.preset{display:flex;gap:10px;padding:10px 0;border-bottom:1px solid #f7f7f7}
.preset:last-child{border-bottom:0}
.radio{flex:0 0 18px;width:18px;height:18px;border-radius:9px;border:1.5px solid #d6d6d6;margin-top:2px}
.preset.on .radio{border-color:#426efe;border-width:5px}
.presetMain{flex:1;min-width:0}
.presetName{font-size:14px;color:#0f0f0f}
.presetDesc{font-size:12px;color:#8e9094;line-height:1.5;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.mpItem{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid #f7f7f7}
.mpItem:last-child{border-bottom:0}
.mpMain{flex:1;min-width:0}
.mpName{font-size:14px;color:#0f0f0f}
.mpDesc{font-size:11px;color:#8e9094;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mpSw{font-size:11px;color:#8e9094;border:1px solid #e5e5e5;border-radius:9px;padding:2px 9px}
.mpItem.on .mpSw{color:#426efe;border-color:#cfe0ff;background:#eaf1ff}

#send{background:#e5e5e5;transition:background .15s}
#send.ready{background:#426efe}
#voiceBtn{border:1.5px solid #0f0f0f}

#modPanel{position:fixed;left:0;right:0;bottom:0;max-height:52vh;background:#fff;border-radius:18px 18px 0 0;box-shadow:0 -8px 24px rgba(0,0,0,.08);transform:translateY(102%);transition:transform .22s cubic-bezier(.2,0,0,1);z-index:60;overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;touch-action:pan-y;display:block}
#modPanel.on{transform:translateY(0)}
#modMask{position:fixed;inset:0;background:rgba(0,0,0,.32);opacity:0;pointer-events:none;transition:opacity .22s;z-index:55}
#modMask.on{opacity:1;pointer-events:auto}
footer{transition:transform .22s cubic-bezier(.2,0,0,1)}
#ctxPop{max-height:40vh;overflow-y:auto}

#modPanel,#ctxPop{position:fixed;left:0;right:0;bottom:0;max-height:52vh;background:#fff;border-radius:18px 18px 0 0;box-shadow:0 -8px 24px rgba(0,0,0,.08);transform:translateY(102%);transition:transform .22s cubic-bezier(.2,0,0,1);z-index:60;overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;touch-action:pan-y;padding:0}
#modPanel.on,#ctxPop.on{transform:translateY(0)}
#modMask{position:fixed;inset:0;background:rgba(0,0,0,.32);opacity:0;pointer-events:none;transition:opacity .22s;z-index:55}
#modMask.on{opacity:1;pointer-events:auto}
footer{transition:transform .22s cubic-bezier(.2,0,0,1)}

/* 与输入框等宽：输入框左右各留 8px */
#modPanel,#ctxPop{left:8px;right:8px;bottom:8px;border-radius:18px;max-height:50vh}

/* V5-ANIM */
#modMask{background:transparent!important;
  backdrop-filter:none!important;
  -webkit-backdrop-filter:none!important;}
footer,#modPanel,#ctxPop{
  transition:transform .22s cubic-bezier(.2,.8,.2,1),
    bottom .22s cubic-bezier(.2,.8,.2,1),
    opacity .18s linear!important;}
#modPanel,#ctxPop{will-change:transform,bottom;}
</style></head>
<body>

<div id="pane-chat">
  <header>
    <div class="ic" id="menuBtn">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#0f0f0f"
        stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </div>
    <div class="title" id="sessionTitle">新对话</div>
    <div class="r">
      <div class="ic" id="soundBtn">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#0f0f0f"
          stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M11 5 6 9H3v6h3l5 4V5z"/><path d="M14.6 9.4a3.6 3.6 0 0 1 0 5.2"/>
          <path d="M17.6 7a7.6 7.6 0 0 1 0 10"/></svg>
      </div>
      <div class="ic" id="newBtn">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#0f0f0f"
          stroke-width="1.8" stroke-linecap="round"><path d="M12 5.5v13M5.5 12h13"/></svg>
      </div>
    </div>
  </header>

  <div id="listbox"><div id="list"></div><button id="jumpBtn" aria-label="回到底部"><svg viewBox="0 0 24 24" fill="none" stroke="#0f0f0f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg></button>
<div id="empty"><svg class="whale" viewBox="0 0 120 80"><path d="M12 48c10-16 30-24 48-24 16 0 28 6 34 14l14-9-4 17 7 10-17-2c-8 8-22 13-37 13-22 0-41-9-45-25z" fill="#426efe"/><path d="M46 34c4-3 9-4 13-3" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round"/><circle cx="38" cy="38" r="3" fill="#fff"/></svg><div class="emptyText">你好，请等会儿再来吧</div></div></div>
  <div id="errbar"></div>

  <div id="notice"><i>i</i><span>服务器繁忙，使用额度已达上限</span></div>
  <footer>
    <div class="card">
      <div id="files"></div>
      <textarea id="input" rows="1" placeholder="发消息或按住说话"></textarea>
      <div class="frow">
        <div class="caps">
          <div class="cap" id="modBtn" title="模块"><svg viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="1.6"
            stroke-linejoin="round"><rect x="4" y="4" width="7" height="7"
            rx="1.6"/><rect x="13" y="4" width="7" height="7" rx="1.6"/>
            <rect x="4" y="13" width="7" height="7" rx="1.6"/>
            <rect x="13" y="13" width="7" height="7" rx="1.6"/></svg>模块</div>
          <div class="cap" id="thinkBtn" title="深度思考"><svg viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="12" cy="12" r="3"/>
            <ellipse cx="12" cy="12" rx="9" ry="4.2"/>
            <ellipse cx="12" cy="12" rx="4.2" ry="9"/></svg>深度思考</div>
          <div class="cap" id="searchBtn" title="智能搜索"><svg viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="12" cy="12" r="9"/>
            <path d="M3 12h18M12 3c3 3.6 3 14.4 0 18M12 3c-3 3.6-3 14.4 0 18"/></svg>智能搜索</div>
          <div class="cap" id="ctxBtn" title="上下文"><svg viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="4" rx="1"/>
            <path d="M5 8v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8"/>
            <path d="M10 12h4"/></svg>上下文</div>
        </div>
        <div class="right">
          <button class="icbtn" id="attachBtn" aria-label="附件">
            <svg viewBox="0 0 24 24" fill="none" stroke="#0f0f0f" stroke-width="1.8"
              stroke-linecap="round"><circle cx="12" cy="12" r="9"/>
              <path d="M12 8.2v7.6M8.2 12h7.6"/></svg>
          </button>
          <button id="voiceBtn" aria-label="语音">
            <svg viewBox="0 0 24 24" fill="none" stroke="#0f0f0f" stroke-width="1.5"
              stroke-linecap="round"><path d="M9 9v6M12 7v10M15 9v6"/></svg>
          </button>
          <button class="send" id="send" aria-label="发送">
            <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 19.5V4.8M5.8 11 12 4.8 18.2 11"/></svg>
          </button>
        </div>
      </div>
    </div>
  </footer>
  <pre id="traces"></pre>
</div>

<div id="pane-tests">
  <div class="thead"><button id="testsBack">返回</button>验收</div>
  <div class="body"><div id="out"></div><div id="sum"></div></div>
</div>

<div id="scrim"></div>
<div id="drawer">
  <div class="dsearch">
    <svg viewBox="0 0 24 24" fill="none" stroke="#8e9094" stroke-width="1.8"
      stroke-linecap="round"><circle cx="11" cy="11" r="6"/><path d="M16 16l4 4"/></svg>
    <span>搜索对话内容…</span></div>
  <div class="dnew" id="newSessionBtn">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#0f0f0f"
      stroke-width="1.8" stroke-linecap="round"><path d="M12 5.5v13M5.5 12h13"/></svg>
    开启新对话</div>
  <div class="dgrp">最近</div>
  <div id="sessionList"></div>
  <div class="dbottom">
    <div class="ditem" id="goApiCheck">真接口诊断</div>
    <div class="ditem" id="goTests">验收测试</div>
    <div class="ditem" id="traceBtn">调试日志</div>
    <div class="ditem" id="setBtn">设置</div>
    <div class="daccount"><div class="ava"></div><div class="mail">本机会话</div></div>
  </div>
</div>

<input type="file" id="fileInput" multiple style="display:none"
  accept=".txt,.md,.json,.js,.ts,.py,.csv,.log,text/*">

<div id="sheetMask"></div>
<div id="sheet">
  <h3>对话设置</h3>
  <div class="f"><label>供应商</label><select id="setProvider"></select>
    <div class="hint" id="provHint"></div></div>
  <div class="f"><label>模型（留空用默认）</label><input id="setModel" placeholder="deepseek-chat"></div><div class="f"><label>API Base Url</label><input id="setBaseUrl" placeholder="https://api.deepseek.com/v1"></div><div class="f"><label>API 路径</label><input id="setPath" placeholder="/chat/completions"></div><div class="f"><label>模型</label><input id="setModelX" placeholder="deepseek-chat"></div><div class="f chk"><input type="checkbox" id="setEcho"><label style="margin:0">回传历史思考</label></div><div class="f chk"><input type="checkbox" id="setResp"><label style="margin:0">Response API（暂未实现）</label></div>
  <div class="f"><label>上下文预算（留空用 4000）</label><input id="setBudget" type="number"></div>
  <div class="f"><label>工具调用轮数</label><input id="setRounds" type="number"></div>
  <div class="f"><label>模块（点击开关）</label><div id="moduleList" class="mods"></div><div class="hint">开关立即影响下一次请求</div></div>
  <div class="f"><label>系统提示词（留空用软模块）</label><textarea id="setPrompt"></textarea></div>
  <div class="f chk"><input type="checkbox" id="setTts"><label style="margin:0">自动朗读</label></div>
  <div class="f chk"><input type="checkbox" id="setLive"><label style="margin:0">使用真接口</label></div>
  <div class="f"><label>API Key（仅本机）</label><input id="setKey" type="password" placeholder="sk-..."></div>
  <div class="f"><label>本会话</label><div class="miniRow"><button class="mini" id="btnRename">重命名</button><button class="mini" id="btnExport">导出</button><button class="mini danger" id="btnDelete">删除</button></div></div><div class="f" id="exportBox" style="display:none"><label>导出内容</label><textarea id="exportText" style="min-height:140px"></textarea><div class="miniRow" style="margin-top:8px"><button class="mini" id="btnCopyExport">复制</button></div></div><div class="sheetBtns">
    <button id="sheetCancel">取消</button><button id="sheetSave" class="primary">保存</button>
  </div>
</div>


<script>
(function () {
  'use strict';
  document.addEventListener('gesturestart', function (e) {
    e.preventDefault();
  }, { passive: false });
  document.addEventListener('gesturechange', function (e) {
    e.preventDefault();
  }, { passive: false });
  /* 顶部继续下拉时阻止整页滚动（老浏览器兜底） */
  var list = document.getElementById('list');
  var startY = 0;
  document.addEventListener('touchstart', function (e) {
    startY = e.touches[0].clientY;
  }, { passive: true });
  document.addEventListener('touchmove', function (e) {
    var dy = e.touches[0].clientY - startY;
    var atTop = (window.scrollY || 0) <= 0 &&
                (!list || list.scrollTop <= 0);
    var tg = e.target;
    if (tg && tg.closest && tg.closest(
        '#modPanel, #modMask, #list, #drawer, #sheet')) {
      return;
    }
    if (atTop && dy > 0) e.preventDefault();
  }, { passive: false });
})();
</script>
<div id="toast"></div>
<div id="modMask"></div>
</body></html>
