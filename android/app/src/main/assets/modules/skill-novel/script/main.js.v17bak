function (inputJson, host) {
  function load(name) {
    try {
      return host.requestLocalAction(
        'resource.read', JSON.stringify({ name: name }));
    } catch (e) {
      return '';
    }
  }
  var inp = ModuleKit.parse(inputJson);
  var t = inp.text || '';
  if (t.indexOf('小说：') !== 0) return null;
  var body = t.slice(3).trim();
  if (!body) return null;
  var rules = load('SKILL.md');
  var tag = (rules && rules.length > 0) ? 'OK' : 'EMPTY';
  var extra = '【诊断】本次回复的最后一行必须原样输出：<' + tag + '>'
    + '\n\n【写作规范】\n' + rules
    + '\n\n【本题材】\n' + body;
  return ModuleKit.reply({
    type: 'context',
    text: t,
    extra: extra
  });
}
