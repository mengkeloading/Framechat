<?xml version="1.0" encoding="utf-8"?>
<!--
  星座：六个点 + 五条线 + 一个孤立点。

  三种颜色：相连的点是蓝、连线是橙、孤立点是灰。
  孤立点用灰而不是蓝的淡化版 —— 它代表「还没被连进来」，语义上是另一类东西，
  不是同一个东西的弱化。刻意不设着色属性：统一着色会把它压成单色。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 五条连线 -->
    <path
        android:pathData="M5,7 L11,5 L16,9 L13,15 L7,16 L5,7"
        android:strokeColor="#FF9500"
        android:strokeWidth="1.1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent" />

    <!-- 五个相连的点 -->
    <path android:pathData="M5,7 m-1.6,0 a1.6,1.6 0,1 1,3.2 0 a1.6,1.6 0,1 1,-3.2 0" android:fillColor="#0A84FF" />
    <path android:pathData="M11,5 m-1.6,0 a1.6,1.6 0,1 1,3.2 0 a1.6,1.6 0,1 1,-3.2 0" android:fillColor="#0A84FF" />
    <path android:pathData="M16,9 m-1.6,0 a1.6,1.6 0,1 1,3.2 0 a1.6,1.6 0,1 1,-3.2 0" android:fillColor="#0A84FF" />
    <path android:pathData="M13,15 m-1.6,0 a1.6,1.6 0,1 1,3.2 0 a1.6,1.6 0,1 1,-3.2 0" android:fillColor="#0A84FF" />
    <path android:pathData="M7,16 m-1.6,0 a1.6,1.6 0,1 1,3.2 0 a1.6,1.6 0,1 1,-3.2 0" android:fillColor="#0A84FF" />

    <!-- 孤立点：还没被连进来 -->
    <path android:pathData="M19,5.5 m-1.3,0 a1.3,1.3 0,1 1,2.6 0 a1.3,1.3 0,1 1,-2.6 0" android:fillColor="#8E8E93" />
</vector>
