<?xml version="1.0" encoding="utf-8"?>
<!--
  星座：六个点 + 五条线 + 一个半透明的孤立点。

  用它而不是 Material 图标，是因为「记忆」在这里的意象是「散点被连成形状」——
  那个孤立点还没被连进来，正好对应"还没有记忆"的状态。
  路径统一白色，颜色由调用方 tint 决定。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 五条连线：细线，先画，压在点下面 -->
    <path
        android:pathData="M5,7 L11,5 L16,9 L13,15 L7,16 L5,7"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent" />

    <!-- 五个已连起来的点 -->
    <path android:pathData="M5,7 m-1.6,0 a1.6,1.6 0,1 1,3.2 0 a1.6,1.6 0,1 1,-3.2 0" android:fillColor="#FFFFFFFF" />
    <path android:pathData="M11,5 m-1.6,0 a1.6,1.6 0,1 1,3.2 0 a1.6,1.6 0,1 1,-3.2 0" android:fillColor="#FFFFFFFF" />
    <path android:pathData="M16,9 m-1.6,0 a1.6,1.6 0,1 1,3.2 0 a1.6,1.6 0,1 1,-3.2 0" android:fillColor="#FFFFFFFF" />
    <path android:pathData="M13,15 m-1.6,0 a1.6,1.6 0,1 1,3.2 0 a1.6,1.6 0,1 1,-3.2 0" android:fillColor="#FFFFFFFF" />
    <path android:pathData="M7,16 m-1.6,0 a1.6,1.6 0,1 1,3.2 0 a1.6,1.6 0,1 1,-3.2 0" android:fillColor="#FFFFFFFF" />

    <!-- 第六个点：还没被连进来 -->
    <path
        android:pathData="M19,5.5 m-1.3,0 a1.3,1.3 0,1 1,2.6 0 a1.3,1.3 0,1 1,-2.6 0"
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.45" />
</vector>
